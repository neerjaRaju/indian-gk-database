{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Indian GK Question",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "difficulty",
    "type",
    "language",
    "question",
    "options",
    "answer_index",
    "explanation",
    "tags",
    "source",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 5,
      "maxLength": 100
    },
    "category": {
      "type": "string",
      "minLength": 2
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "type": {
      "const": "mcq"
    },
    "language": {
      "enum": [
        "en",
        "hi"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 5
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "answer_index": {
      "type": "integer",
      "minimum": 0
    },
    "explanation": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "url",
        "publisher",
        "accessed_on",
        "license"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "publisher": {
          "type": "string"
        },
        "accessed_on": {
          "type": "string",
          "format": "date"
        },
        "license": {
          "type": "string"
        }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    }
  }
}
